# LogRhythm private packages configuration
# Replace LOGRHYTHM_REGISTRY_URL with your actual LogRhythm npm registry URL
# Common patterns:
# - https://your-company.pkgs.visualstudio.com/_packaging/YourFeed/npm/registry/
# - https://nexus.logrhythm.com/repository/npm-public/
# - https://npm.logrhythm.com/

@logrhythm:registry=https://registry.npmjs.org/
# Uncomment and modify the line above with your actual LogRhythm registry URL:
# @logrhythm:registry=https://YOUR_LOGRHYTHM_REGISTRY_URL/

# If authentication is required, uncomment and configure:
# //YOUR_LOGRHYTHM_REGISTRY_URL/:_authToken=YOUR_AUTH_TOKEN
# //YOUR_LOGRHYTHM_REGISTRY_URL/:username=YOUR_USERNAME
# //YOUR_LOGRHYTHM_REGISTRY_URL/:_password=YOUR_PASSWORD_BASE64
# //YOUR_LOGRHYTHM_REGISTRY_URL/:email=YOUR_EMAIL

# Fallback to public registry for other packages
registry=https://registry.npmjs.org/