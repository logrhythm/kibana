{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./target/types",
    "outDir": "./target/out",
    "stripInternal": true,
    "declarationMap": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "skipLibCheck": true,
    "suppressImplicitAnyIndexErrors": true,
    "composite": true,
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "./types/joi.d.ts",
    "./src/**/*.ts"
  ],
  "exclude": [
    "target"
  ],
  "references": [
    { "path": "../kbn-std" }
  ]
}
