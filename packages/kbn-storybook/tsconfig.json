{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "outDir": "target",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noErrorTruncation": false
  },
  "include": ["*.ts", "lib/*.ts", "types.d.ts"],
  "exclude": [
    "node_modules/**/*",
    "**/node_modules/**/*",
    "node_modules/@types/webpack-merge/**/*"
  ]
}
